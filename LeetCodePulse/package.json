{
  "name": "leetcode-pulse-widget",
  "version": "1.0.0",
  "description": "Desktop widget showing your LeetCode submission heatmap",
  "main": "main.js",
  "scripts": {
    "start": "env -u ELECTRON_RUN_AS_NODE electron .",
    "dist": "env -u ELECTRON_RUN_AS_NODE electron-builder --mac"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "45.2.2",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.leetcodepulse.widget",
    "productName": "LeetCode Pulse",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "dmg"
      ],
      "identity": null,
      "extendInfo": {
        "LSUIElement": true
      }
    },
    "dmg": {
      "title": "LeetCode Pulse"
    }
  }
}
